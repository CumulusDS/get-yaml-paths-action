{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.build.json"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": null,
    "rootDirs": [".", "src"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "verbatimModuleSyntax": false
  },
  "include": ["scripts", "src", "test", "./*.cts", "./*.mts", "./*.ts"]
}
