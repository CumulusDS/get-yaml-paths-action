{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@cumulusds/tsconfig/nodenext"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "${configDir}/src",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.build.tsbuildinfo",
    "verbatimModuleSyntax": false,
    "paths": {
      "@src/*": ["./src/*"]
    },
  },
  "include": ["src"]
}
